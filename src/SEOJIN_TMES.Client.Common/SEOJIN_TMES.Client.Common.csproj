<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>SEOJIN_TMES.Client.Common</RootNamespace>
    <AssemblyName>SEOJIN_TMES.Client.Common</AssemblyName>
  </PropertyGroup>

  <!-- 로그인 요청 바디의 필드명(orgNo/password/salt)을 서버 스펙과 정확히 맞추기 위해 JsonProperty를 쓴다. -->
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <!-- 로그 파일 7일 단위 zip 백업(AppLog). .NET Framework에서는 두 어셈블리를 직접 참조해야 한다. -->
  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

</Project>
