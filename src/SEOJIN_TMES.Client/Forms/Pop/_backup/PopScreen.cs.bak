using System;
using System.Threading.Tasks;
using System.Windows.Forms;
using DevExpress.XtraEditors;
using SEOJIN_TMES.Client.ApiClient;
using SEOJIN_TMES.Client.Common.Logging;
using SEOJIN_TMES.Client.Common.Models;
using SEOJIN_TMES.Client.Forms.Common;
using SEOJIN_TMES.Client.Composition;
using SEOJIN_TMES.Client.Equipment;
using SEOJIN_TMES.Client.Equipment.Protocol;
using SEOJIN_TMES.Client.Forms.WorkOrderEntry;
using SEOJIN_TMES.Client.Localization;
using SEOJIN_TMES.Client.Theme;

namespace SEOJIN_TMES.Client.Forms.Pop
{
    /// <summary>
    /// MEIS > 작업관리 > POP.
    /// 작업지시 조회(서버 REST API) + 설비 상태 모니터링/제어(Modbus-TCP)를 한 화면에서 다룬다.
    /// 설비 통신은 두 Connection을 함께 사용한다 —
    ///  - 표준 Modbus-TCP connection   : Start/Stop/Reset 등 Read/Write 요청 → 응답
    ///  - Customized Modbus-TCP connection(포트+1) : 장비가 밀어 올리는 실시간 이벤트 수신
    ///
    /// 화면은 3개 카드(설비 제어 / 작업지시 그리드 / 설비 로그 콘솔)로 구성되며,
    /// 색·폰트·아이콘은 <see cref="AppTheme"/>가 담당한다(테마 전환 시 <see cref="ApplyTheme"/>가 다시 호출됨).
    ///
    /// VS 디자이너 호환을 위해 매개변수 없는 생성자만 두고, 실제 의존성은 Initialize()로 주입한다.
    /// </summary>
    public partial class PopScreen : XtraUserControl, IThemedScreen
    {
        private ClientContext _context;
        private WorkEntryContext _entry;

        public PopScreen()
        {
            InitializeComponent();
        }

        public void Initialize(ClientContext context)
        {
            Initialize(context, null);
        }

        /// <summary>
        /// POP 진입 화면에서 선택한 작업 대상(<paramref name="entry"/>)을 함께 받는다.
        /// 메뉴에서 바로 열린 경우처럼 대상이 없으면 null이며, 그때는 상단에 대상 표시를 하지 않는다.
        /// </summary>
        public void Initialize(ClientContext context, WorkEntryContext entry)
        {
            _context = context;
            _entry = entry;

            lblEquipment.Text = Strings.Pop_EquipmentStatus;
            btnStart.Text = Strings.Pop_Start;
            btnStop.Text = Strings.Pop_Stop;
            btnReset.Text = Strings.Pop_Reset;
            btnRefresh.Text = Strings.Common_Refresh;
            lblWorkOrders.Text = Strings.Pop_WorkOrderList;
            lblLogTitle.Text = Strings.Pop_EquipmentLog;
            lblEntryTarget.Text = _entry != null ? $"{Strings.Pop_EntryTarget} : {_entry.Summary}" : string.Empty;

            ApplyTheme();

            cboEquipment.SelectedIndexChanged += (s, e) => RefreshConnectionStateLabel();

            WireEquipmentEvents();
            Load += PopScreen_Load;
            Disposed += (s, e) => UnwireEquipmentEvents();
        }

        /// <summary>현재 테마 색을 화면 전체에 입힌다. 상단바에서 라이트/다크를 전환하면 다시 호출된다.</summary>
        public void ApplyTheme()
        {
            BackColor = AppTheme.Surface;
            spacerTop.BackColor = AppTheme.Surface;
            spacerBottom.BackColor = AppTheme.Surface;

            AppTheme.CardPanel(topCard);
            AppTheme.CardPanel(centerCard);
            AppTheme.CardPanel(logCard);

            AppTheme.SectionTitle(lblEquipment, AppTheme.Violet);
            AppTheme.BodyText(lblEntryTarget, true);
            AppTheme.SectionTitle(lblWorkOrders, AppTheme.Indigo);
            AppTheme.SectionTitle(lblLogTitle, AppTheme.Cyan);

            AppTheme.Editor(cboEquipment);
            AppTheme.AccentButton(btnStart, AppTheme.Emerald, AppIcons.Play);
            AppTheme.AccentButton(btnStop, AppTheme.Rose, AppIcons.Stop);
            AppTheme.AccentButton(btnReset, AppTheme.Amber, AppIcons.Reset);
            AppTheme.QuietButton(btnRefresh, AppTheme.Indigo, AppIcons.Refresh);

            AppTheme.Grid(gridWorkOrders, gridViewWorkOrders, AppTheme.Indigo);
            AppTheme.Console(txtEquipmentLog);

            RefreshConnectionStateLabel();
        }

        private async void PopScreen_Load(object sender, EventArgs e)
        {
            cboEquipment.Properties.Items.Clear();
            foreach (var id in _context.EquipmentManager.EquipmentIds)
                cboEquipment.Properties.Items.Add(id);

            if (cboEquipment.Properties.Items.Count > 0)
                cboEquipment.SelectedIndex = 0;

            RefreshConnectionStateLabel();
            await LoadWorkOrdersAsync();
        }

        private async Task LoadWorkOrdersAsync()
        {
            try
            {
                var equipmentId = SelectedEquipmentId();
                var workOrders = await _context.ApiClients.WorkOrderApiClient.GetWorkOrdersAsync(equipmentId);
                gridWorkOrders.DataSource = workOrders;
            }
            catch (ApiException ex)
            {
                AppMessageBox.Warn(this, ex.Message, Strings.Pop_Title);
            }
        }

        private async void btnStart_Click(object sender, EventArgs e) => await SendCommandAsync(EquipmentCommand.Start());
        private async void btnStop_Click(object sender, EventArgs e) => await SendCommandAsync(EquipmentCommand.Stop());
        private async void btnReset_Click(object sender, EventArgs e) => await SendCommandAsync(EquipmentCommand.Reset());
        private async void btnRefresh_Click(object sender, EventArgs e) => await LoadWorkOrdersAsync();

        /// <summary>
        /// 논리 명령을 표준 Modbus-TCP connection으로 보내고 응답까지 확인한다.
        /// 실제 레지스터 주소/값은 App.config의 Equipments[].RegisterMap 설정을 따른다.
        /// </summary>
        private async Task SendCommandAsync(EquipmentCommand command)
        {
            var equipmentId = SelectedEquipmentId();
            if (string.IsNullOrEmpty(equipmentId))
                return;

            try
            {
                var response = await _context.EquipmentManager.SendCommandAsync(equipmentId, command);
                AppendLog($"[{equipmentId}] {command.Type} 명령 전송 완료 - 응답 {response}");
            }
            catch (ModbusProtocolException ex)
            {
                AppendLog($"[{equipmentId}] {command.Type} 명령 거부(장비 예외 응답): {ex.Message}");
            }
            catch (ModbusTimeoutException ex)
            {
                AppendLog($"[{equipmentId}] {command.Type} 명령 응답 없음: {ex.Message}");
            }
            catch (Exception ex)
            {
                AppendLog($"[{equipmentId}] {command.Type} 명령 전송 실패: {ex.Message}");
            }
        }

        private void WireEquipmentEvents()
        {
            _context.EquipmentManager.DataReceived += EquipmentManager_DataReceived;
            _context.EquipmentManager.ConnectionChanged += EquipmentManager_ConnectionChanged;
            _context.EquipmentManager.ErrorOccurred += EquipmentManager_ErrorOccurred;
        }

        private void UnwireEquipmentEvents()
        {
            _context.EquipmentManager.DataReceived -= EquipmentManager_DataReceived;
            _context.EquipmentManager.ConnectionChanged -= EquipmentManager_ConnectionChanged;
            _context.EquipmentManager.ErrorOccurred -= EquipmentManager_ErrorOccurred;
        }

        /// <summary>
        /// 설비에서 올라온 프레임 처리.
        /// Customized(이벤트) Connection의 실시간 이벤트와, 표준 Connection에서 요청과 짝이 맞지 않은
        /// 비요청 프레임이 여기로 온다(요청에 대한 정상 응답은 SendCommandAsync가 직접 받는다).
        /// </summary>
        private void EquipmentManager_DataReceived(object sender, EquipmentDataReceivedEventArgs e)
        {
            InvokeIfRequired(() =>
            {
                var kind = e.Channel == EquipmentChannel.Event ? "실시간 이벤트" : "비요청 프레임";
                AppendLog($"[{e.EquipmentId}/{e.Channel}] {kind} 수신: {e.Frame}");

                // TODO: 이벤트/레지스터 맵 스펙 확정 후, 레지스터 값을 RunState/AlarmCode/ProductionCount로 정확히 매핑한다.
                //       현재는 첫 레지스터 값(없으면 기능 코드)을 상태 문자열로 그대로 올려 서버가 원본을 볼 수 있게 한다.
                var registers = e.Frame.GetRegisters();
                var status = new EquipmentStatusDto
                {
                    EquipmentId = e.EquipmentId,
                    RunState = registers.Length > 0 ? registers[0].ToString() : $"FC0x{e.Frame.FunctionCode:X2}",
                    ReportedAtUtc = DateTime.UtcNow
                };
                _ = _context.ApiClients.EquipmentStatusApiClient.ReportStatusAsync(status);
            });
        }

        private void EquipmentManager_ConnectionChanged(object sender, EquipmentConnectionChangedEventArgs e)
        {
            InvokeIfRequired(() =>
            {
                AppendLog($"[{e.EquipmentId}/{e.Channel}] 연결상태: {e.State} {e.Message}");
                RefreshConnectionStateLabel();
            });
        }

        private void EquipmentManager_ErrorOccurred(object sender, EquipmentErrorEventArgs e)
        {
            InvokeIfRequired(() => AppendLog($"[{e.EquipmentId}/{e.Channel}] 오류: {e.Exception.Message}"));
        }

        /// <summary>
        /// 두 Connection(표준/이벤트)의 상태를 알약(pill) 라벨 하나에 색으로 함께 표시한다.
        /// 색 기준: 연결=초록, 연결중=주황, 오류=빨강, 해제=회색 (둘 중 더 심각한 쪽 색을 쓴다).
        /// </summary>
        private void RefreshConnectionStateLabel()
        {
            var equipmentId = SelectedEquipmentId();
            if (string.IsNullOrEmpty(equipmentId))
            {
                lblConnectionState.Text = string.Empty;
                AppTheme.StatePill(lblConnectionState, AppTheme.Slate, new System.Drawing.Size(250, 28));
                return;
            }

            var manager = _context.EquipmentManager;
            var hasStandard = manager.HasChannel(equipmentId, EquipmentChannel.Standard);
            var hasEvent = manager.HasChannel(equipmentId, EquipmentChannel.Event);

            var standardState = hasStandard ? manager.GetState(equipmentId, EquipmentChannel.Standard).ToString() : null;
            var eventState = hasEvent ? manager.GetState(equipmentId, EquipmentChannel.Event).ToString() : null;

            lblConnectionState.Text = $"표준 {StateText(standardState)} · 이벤트 {StateText(eventState)}";
            AppTheme.StatePill(lblConnectionState, WorseColor(standardState, eventState), new System.Drawing.Size(210, 28));
        }

        /// <summary>
        /// 콤보에서 선택된 설비 ID. SelectedItem이 아직 비어 있는 시점(로드 직후 등)에는
        /// 표시 문자열(Text)을 사용한다 — 그래야 상태 알약이 빈칸으로 남지 않는다.
        /// </summary>
        private string SelectedEquipmentId()
        {
            var selected = cboEquipment.SelectedItem as string;
            return !string.IsNullOrEmpty(selected) ? selected : cboEquipment.Text;
        }

        /// <summary>해당 Connection이 설정되어 있지 않으면 "미사용", 그 외에는 짧은 한글 상태 표기.</summary>
        private static string StateText(string state) =>
            state == null ? "미사용" : AppTheme.ConnectionStateText(state);

        private static System.Drawing.Color WorseColor(string first, string second)
        {
            if (first == "Faulted" || second == "Faulted") return AppTheme.Rose;
            if (first == "Connecting" || second == "Connecting") return AppTheme.Amber;
            if (first == "Connected" || second == "Connected") return AppTheme.Emerald;
            return AppTheme.Slate;
        }

        private void AppendLog(string message)
        {
            AppLog.Info($"[POP] {message}");
            txtEquipmentLog.Text = $"{DateTime.Now:HH:mm:ss} {message}{Environment.NewLine}{txtEquipmentLog.Text}";
        }

        private void InvokeIfRequired(Action action)
        {
            if (IsDisposed) return;
            if (InvokeRequired) BeginInvoke(action);
            else action();
        }
    }
}
