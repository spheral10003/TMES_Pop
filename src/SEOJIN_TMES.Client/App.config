<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>

  <appSettings>
	  
	  <!--
	  도메인 주소
	    <구미사업장>
        -운영 :  https://tmes-gm.texon.co.kr
        -테스트 : https://tmes-gm-test.texon.co.kr

        <화성사업장>
        -운영 :  https://tmes-hs.texon.co.kr
        -테스트 : https://tmes-hs-test.texon.co.kr

        <용인사업장>
        -운영 :  https://tmes-yi.texon.co.kr
        -테스트 : https://tmes-yi-test.texon.co.kr
	  
	  
	  -->
    <!--
      TODO: 실제 서버 주소로 교체.
      주의: 스킴(http/https)을 서버 실제 구성과 반드시 일치시킬 것.
      서버가 평문 HTTP인데 https://로 호출하면 "예기치 않은 패킷 형식으로 인해 핸드셰이크가 실패했습니다" 오류가 난다.
	  <add key="ApiBaseUrl" value="http://10.200.1.237:8080/" />
	  <add key="ApiBaseUrl" value="http://192.168.33.35:8080/" />
	  <add key="ApiBaseUrl" value="http://172.16.150.212:8080/" />
	  
    -->

	  <!--
	  서진 Test 서버
	  <add key="ApiBaseUrl" value="http://10.200.1.237:8080/" />
	  구미 Test 서버
	  <add key="ApiBaseUrl" value="http://172.16.150.11:8080/" />
	  구미 운영 서버
	  <add key="ApiBaseUrl" value="http://172.16.150.248:8080/" />
	  구미 App 서버
	  <add key="ApiBaseUrl" value="http://172.16.150.247:8080/" />
	  
	  <구미사업장>
        -운영 :  https://tmes-gm.texon.co.kr
        -테스트 : https://tmes-gm-test.texon.co.kr
        <add key="ApiBaseUrl" value="https://tmes-gm-test.texon.co.kr/" />
        <화성사업장>
        -운영 :  https://tmes-hs.texon.co.kr
        -테스트 : https://tmes-hs-test.texon.co.kr
        <add key="ApiBaseUrl" value="https://tmes-hs-test.texon.co.kr/" />
        <용인사업장>
        -운영 :  https://tmes-yi.texon.co.kr
        -테스트 : https://tmes-yi-test.texon.co.kr
	    <add key="ApiBaseUrl" value="https://tmes-yi-test.texon.co.kr/" />
	  
	  
	  -->
	  <add key="ApiBaseUrl" value="https://tmes-hs-test.texon.co.kr/" />
    <add key="ApiTimeoutSeconds" value="30" />
	  <!--
      사업장 코드(corpCd). 기본값 GUM.
      로그인 때 서버로 그대로 보내고, 로그인 화면 사업부 표시도 이 값으로 정한다.
      GUM : Texon 구미 / HS : Texon 화성 / YI : Texon 용인 (그 밖의 값은 코드를 그대로 표시)
    -->
	  <add key="ServerName" value="HS" />
    <!--
      파일 업로드 제한 시간. 업로드는 위 ApiTimeoutSeconds(요청 전체 30초)를 쓰지 않는다 —
      200MB 문서는 보내는 데만 30초를 넘겨 전송 도중에 끊겼다.
      제한 시간 = ApiUploadTimeoutSeconds + 본문 크기 ÷ ApiUploadMinKBytesPerSecond
        ApiUploadTimeoutSeconds     : 기본분(초). 서버가 받은 파일을 저장하고 응답할 여유. 기본 60.
        ApiUploadMinKBytesPerSecond : 가정하는 최저 전송 속도(KB/초). 기본 512.
                                      예) 219MB → 60 + 약 428 = 약 8분. 망이 이보다 느려 시간 초과가 나면 낮춘다.
    -->
    <add key="ApiUploadTimeoutSeconds" value="60" />
    <add key="ApiUploadMinKBytesPerSecond" value="512" />

    <!--
      API 응답 본문을 로그에 남길지 여부(기본 true) / 남길 최대 길이(기본 4000자).
      서버 연동을 맞추는 동안 응답 모양을 눈으로 확인하려고 켜 둔다.
      비밀번호·토큰·salt 같은 필드는 기록 전에 ***로 가려지지만 업무 데이터는 그대로 남으므로,
      현장 운영 배포에서는 false 로 두는 것을 권한다(로그 용량도 크게 늘어난다).
    -->
    <add key="LogApiResponseBody" value="true" />
    <add key="LogApiResponseBodyMaxLength" value="1000000" />
    <add key="DefaultCulture" value="ko-KR" />
    
    <!--
      테스트 서버 실행 여부. 기본값 false(운용 서버).
      true  : 프로그램 아이콘 TMES_TEST.ico, 메인 화면 상단 바 주황(#EB6E1D), 접힌 메뉴 로고 TMES_TEST_256.png
      false : 프로그램 아이콘 TMES.ico, 상단 바 기본 파랑, 접힌 메뉴 로고 TMES_256.png
      화면 표시만 바뀐다 — 실제 접속 서버는 ApiBaseUrl 이 정하므로 함께 맞출 것.
    -->
    <add key="IsTestServer" value="false" />
	  <add key="UploadMaxMegaBytes" value="1000" />  
    <!--
      안 읽은 알림 개수를 서버에 물어보는 주기(초). 상단 종 아이콘의 빨간 배지 숫자가 이 간격으로 갱신된다.
      같은 주기에 공지(gm/notices)도 조회해서, 새 공지가 있으면 홈 공지 상자를 다시 채운다. 기본값 60.
      0 이하로 두면 폴링을 하지 않는다(서버가 아직 없을 때 호출을 아예 막고 싶은 경우).
    -->
    <add key="NotificationPollingSeconds" value="60" />

    <!-- 자동 로그아웃까지의 세션 유지 시간(분). 메인 화면 우측 상단에 남은 시간이 카운트다운으로 표시된다(300분 = 05:00:00). -->
    <add key="SessionTimeoutMinutes" value="300" />
    <!--
      설비(Nutrunner) Modbus-TCP 연결 설정. Request · Event 두 채널 모두 적용된다.
        ModbusConnectTimeoutMs    : TCP 접속 제한 시간(ms). 기본 500. 0 이하면 OS 기본값(약 21초)까지 기다린다.
                                    망이 느려 "접속 시간 초과"가 잦으면 늘린다.
                                    응답 대기(Alive 포함)는 아래 ModbusResponseTimeoutMs가 따로 정한다.
        ModbusKeepAliveTimeMs     : 무통신 후 첫 TCP KeepAlive 확인까지의 시간(ms). 기본 5000. 0 이하면 KeepAlive 끔.
        ModbusKeepAliveIntervalMs : KeepAlive 응답이 없을 때 재확인 간격(ms). 기본 5000.
      KeepAlive는 랜선 단선 · 장비 전원 차단처럼 신호 없이 끊긴 연결을 감지하려고 쓴다.
      Windows는 재확인을 10회 하므로 끊김 감지까지 약 TimeMs + 10 × IntervalMs(기본 약 55초)가 걸린다.
    -->
    <add key="ModbusConnectTimeoutMs" value="2000" />
    <add key="ModbusKeepAliveTimeMs" value="5000" />
    <add key="ModbusKeepAliveIntervalMs" value="5000" />
    <!--
      ModbusResponseTimeoutMs : 설비 Request 요청 하나의 응답 대기 시간(ms). Alive(5초 주기) 응답 대기에도 쓴다. 기본 2000.
                                이 시간 안에 Alive 응답이 없으면 바로 다시 보내고, 3회 다시 보내도 없으면 끊고 재연결한다.
                                0 이하면 1000. 너무 짧으면(예전 500) 장비가 잠깐 늦을 때마다 연결을 끊는다.
    -->
    <add key="ModbusResponseTimeoutMs" value="2000" />
    <!--
      ModbusReconnectWaitMs : 설비 재연결 3회(2초 간격)가 모두 실패한 뒤 다음 3회를 시작하기까지 쉬는 시간(ms). 기본 10000.
                              실패가 이어져도 이 시간은 늘리지 않고 "3회 시도 → 대기"를 연결될 때까지 반복한다.
                              0 이하면 10000.
    -->
    <add key="ModbusReconnectWaitMs" value="10000" />
    <!--
      ModbusEventConnectDelayMs : 설비 Request 포트(예 5000) 접속 완료 후 Event 포트(Port+1, 예 5001) 접속을 시작하기까지의 대기 시간(ms). 기본 500.
                                  두 포트를 연달아 열면 Event 포트 접속을 받지 못하는 장비가 있어 "Request 접속 → 대기 → Event 접속" 순서로 연다.
                                  0 이하면 기다리지 않고 바로 연다.
    -->
    <add key="ModbusEventConnectDelayMs" value="500" />
    <!--
      설비 접속 테스트 팝업(상단 바의 네트워크 아이콘). Request 포트 → Event 포트 순으로 붙었다가 끊기를
      반복 횟수만큼 하고 성공/실패 횟수를 보여 준다. 운영 연결(위 ModbusConnectTimeoutMs)과는 따로 쓴다.
        ModbusTestTimeoutMs  : 포트 하나에 접속을 기다리는 시간(ms). 넘으면 실패로 센다. 기본 2000.
        ModbusTestIntervalMs : 끊은 뒤 다음 접속까지 쉬는 시간(ms). 0이면 바로 다시 붙는다. 기본 300.
    -->
    <add key="ModbusTestTimeoutMs" value="2000" />
    <add key="ModbusTestIntervalMs" value="300" />

    <!--
      작업 표준/도면 PDF가 들어 있는 SMB 공유 폴더(JSON). POP 화면 좌측 도면 영역이 여기서 파일을 읽는다.
      표시할 파일 경로는 서버(진행 중 공정 정보 API)가 DrawingFilePath로 내려주며,
      상대 경로면 아래 RootPath와 합쳐 실제 UNC 경로가 된다.

        RootPath : 공유 폴더 루트. 예 "\\\\192.168.0.50\\drawings" (JSON이라 역슬래시를 두 번 쓴다)
                   비워 두면 도면 영역에 "공유 폴더 미설정" 안내만 나오고 파일 접근을 시도하지 않는다.
        UserName : 공유 접속 계정. **비우면 현재 로그인한 윈도우 계정으로 접근한다(권장)**.
                   값이 있으면 그 계정으로 공유에 연결한다(WNetAddConnection2).
        Password : UserName을 채운 경우에만 사용.
        Domain   : 도메인/컴퓨터 이름. UserName에 "DOMAIN\\user" 형태로 이미 넣었으면 비워 둔다.

      보안 주의: Password를 채우면 이 파일에 평문으로 남는다.
      가능하면 PC를 도메인에 넣고 UserName/Password를 비운 채 쓰거나, 배포 시 이 파일의 접근 권한을 제한할 것.
	  
	  서진 Test 서버
	  10.200.1.235
	  administrator
	  Passw0rd!
	  
	  서진 Test 서버
	  <add key="DocumentShare" value="{&quot;RootPath&quot;:&quot;\\\\10.200.1.31\\sjapp\\attach\\&quot;,&quot;UserName&quot;:&quot;seojin&quot;,&quot;Password&quot;:&quot;Hqmes*101&quot;,&quot;Domain&quot;:&quot;&quot;}" />
	  UserName : seojin
	  Password : Hqmes*101
	  
	  구미 Test 서버
	  <add key="DocumentShare" value="{&quot;RootPath&quot;:&quot;\\\\172.16.150.11\\tmes\\attach\\&quot;,&quot;UserName&quot;:&quot;TMES_Pop&quot;,&quot;Password&quot;:&quot;Tx2@26&quot;,&quot;Domain&quot;:&quot;&quot;}" />  
	  SMB 계정
	  UserName : tmespop
	  Password : TxoNSjs$#62**+-*/
	  
	  배포 계정
	  UserName : tmesdeploy
	  Password : SjSyTxN47#$.,!#*83*
	  
	  구미 운영 서버
	  <add key="DocumentShare" value="{&quot;RootPath&quot;:&quot;\\\\10.200.1.31\\sjapp\\attach\\&quot;,&quot;UserName&quot;:&quot;seojin&quot;,&quot;Password&quot;:&quot;Hqmes*101&quot;,&quot;Domain&quot;:&quot;&quot;}" />
	  SMB 계정
	  UserName : tmespop
	  Password : TxoNSjs$#62**+-*/
	  
	  배포 계정
	  UserName : tmesdeploy
	  Password : SjSyTxN47#$.,!#*83*
	  
	  TMES_Pop / Tx2@26
	  <add key="DocumentShare" value="{&quot;RootPath&quot;:&quot;\\\\172.16.150.11\\tmes\\attach\\&quot;,&quot;UserName&quot;:&quot;tmespop&quot;,&quot;Password&quot;:&quot;TxoNSjs$#62**+-*/&quot;,&quot;Domain&quot;:&quot;&quot;}" />
    -->

	  <add key="DocumentShare" value="{&quot;RootPath&quot;:&quot;\\\\172.16.150.11\\tmes\\attach\\&quot;,&quot;UserName&quot;:&quot;tmespop&quot;,&quot;Password&quot;:&quot;TxoNSjs$#62**+-*/&quot;,&quot;Domain&quot;:&quot;&quot;}" />

  </appSettings>

  <system.net>
    <settings>
      <httpWebRequest useUnsafeHeaderParsing="true" />
    </settings>
  </system.net>
</configuration>
