		<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>SEOJIN_TMES.Client</RootNamespace>
    <AssemblyName>SEOJIN_TMES_POP</AssemblyName>
    <!--
      실행 파일(exe) 아이콘 — 탐색기·바탕화면·작업 표시줄의 "고정" 항목이 이 값을 쓴다.
      .ico 만 인식하며, 빌드할 때 박히므로 실행 중에 바꿀 수 없다 — 운용 서버 아이콘(TMES.ico)으로 고정한다.
      창/작업 표시줄에 뜨는 아이콘은 이것과 별개로 각 Form의 Icon 속성이 결정하며,
      App.config의 IsTestServer에 따라 TMES.ico / TMES_TEST.ico 중 하나를 쓴다(AppImages.AppIcon).
    -->
    <ApplicationIcon>Images\TMES_TEST.ico</ApplicationIcon>
    <NeutralLanguage>ko-KR</NeutralLanguage>
  </PropertyGroup>

  <!--
    Debug 구성에서는 OutputType=Exe(콘솔 서브시스템)로 빌드해 WinForms 창과 함께 콘솔 창이 자동으로 뜨게 한다.
    AppLog.Step/Info/... 가 Console.WriteLine으로 출력하므로 디버그 실행 중 단계별 로그를 콘솔 창에서 그대로 볼 수 있다.
    Release(배포용 ClickOnce)에서는 콘솔 창이 뜨면 안 되므로 WinExe(GUI 서브시스템) 그대로 둔다.
  -->
  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'!='Debug'">
    <OutputType>WinExe</OutputType>
  </PropertyGroup>

  <!--
    ClickOnce 배포 설정.
    지역(구미 · 화성 · 용인 · 베트남 · 미국)별 게시는 deploy/Publish-ClickOnce.ps1 로 한다 — 사용법은 DEPLOY_GUIDE.md.
    아래는 지역과 무관한 공통값이고, -p:Region=<지역> 이 주어지면 deploy/regions/<지역>/region.props 가
    배포 서버 주소 · 제품 이름 · App.config 를 덮어쓴다.
  -->
  <PropertyGroup>
    <PublishUrl>bin\publish\</PublishUrl>
    <Install>true</Install>
    <InstallFrom>Disk</InstallFrom>
    <!-- 실행할 때마다 창이 뜨기 전에 서버의 새 버전을 확인한다(Foreground). POP는 하루 종일 켜 두므로 주기 확인은 쓰지 않는다. -->
    <UpdateEnabled>true</UpdateEnabled>
    <UpdateMode>Foreground</UpdateMode>
    <UpdateInterval>7</UpdateInterval>
    <UpdateIntervalUnits>Days</UpdateIntervalUnits>
    <UpdatePeriodically>false</UpdatePeriodically>
    <UpdateRequired>false</UpdateRequired>
    <MapFileExtensions>true</MapFileExtensions>
    <ApplicationRevision>0</ApplicationRevision>
    <!-- VS 게시 마법사용 기본값. 스크립트 게시는 -p:ApplicationVersion=1.0.0.N 으로 정확한 버전을 넘긴다. -->
    <ApplicationVersion>1.0.0.%2a</ApplicationVersion>
    <UseApplicationTrust>false</UseApplicationTrust>
    <BootstrapperEnabled>true</BootstrapperEnabled>
    <SignManifests>false</SignManifests>
    <GenerateManifests>true</GenerateManifests>
    <!-- 완전 신뢰. 권한 집합은 Properties\app.manifest 에 있다(LocalIntranet 이면 소켓 · 공유 폴더 접근이 막힌다). -->
    <TargetZone>Custom</TargetZone>
    <ApplicationManifest>Properties\app.manifest</ApplicationManifest>
    <ProductName>TMES POP</ProductName>
    <PublisherName>SEOJIN_TMES</PublisherName>
    <SuiteName>TMES</SuiteName>
    <CreateDesktopShortcut>true</CreateDesktopShortcut>
  </PropertyGroup>

  <!-- 지역별 게시 설정. Region 없이 빌드(F5 · 일반 빌드)하면 위 공통값과 개발용 App.config 그대로다. -->
  <PropertyGroup Condition="'$(Region)'!=''">
    <RegionDir>$(MSBuildThisFileDirectory)..\..\deploy\regions\$(Region)\</RegionDir>
  </PropertyGroup>
  <Import Project="$(RegionDir)region.props" Condition="'$(Region)'!='' And Exists('$(RegionDir)region.props')" />
  <PropertyGroup Condition="'$(Region)'!=''">
    <!-- SDK 형식 프로젝트는 이 값이 없으면 -t:Publish 가 ClickOnce가 아닌 일반 폴더 복사로 끝난다. -->
    <PublishProtocol>ClickOnce</PublishProtocol>
    <InstallFrom>Web</InstallFrom>
    <IsWebBootstrapper>true</IsWebBootstrapper>
    <InstallUrl>$(DeployBaseUrl)</InstallUrl>
    <UpdateUrl>$(DeployBaseUrl)</UpdateUrl>
  </PropertyGroup>
  <!--
    최소 필수 버전을 주면 그보다 낮은 PC는 [건너뛰기] 없이 반드시 업데이트한다.
    MES는 서버 API와 버전이 어긋나면 안 되므로 스크립트는 기본으로 "이번 게시 버전"을 최소 버전으로 넘긴다.
  -->
  <PropertyGroup Condition="'$(MinimumRequiredVersion)'!=''">
    <UpdateRequired>true</UpdateRequired>
  </PropertyGroup>
  <Target Name="CheckRegion" BeforeTargets="PrepareForBuild" Condition="'$(Region)'!=''">
    <Error Condition="!Exists('$(RegionDir)region.props')" Text="지역 설정이 없다: $(RegionDir)region.props — deploy/regions 아래 폴더 이름을 확인할 것." />
    <Error Condition="'$(DeployBaseUrl)'==''" Text="$(Region) 지역의 배포 서버 주소(DeployBaseUrl)가 비어 있다 — deploy/Publish-ClickOnce.ps1 -Region $(Region) -Configure 로 입력할 것." />
  </Target>
  <ItemGroup>
    <Compile Remove="Localization\**" />
    <EmbeddedResource Remove="Localization\**" />
    <None Remove="Localization\**" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Forms\Pop\ByteToImage.cs" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Images\TMES_TEST.ico" />
  </ItemGroup>
