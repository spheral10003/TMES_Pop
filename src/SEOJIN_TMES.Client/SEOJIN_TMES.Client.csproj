  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <!--
    PopScreen partial 파일들 — PopScreen(XtraUserControl)의 일부라 VS가 유저 컨트롤로 표시한다.
    솔루션 탐색기에서 PopScreen.cs 아래로 묶어 본체 · 디자이너와 한 덩어리로 보이게 한다(빌드와는 무관).
  -->
  <ItemGroup>
    <Compile Update="Forms\Pop\PopScreen.Grid.cs">
