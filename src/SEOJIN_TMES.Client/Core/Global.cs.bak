using System;

namespace SEOJIN_TMES.Client.Core
{
    public class Global
    {
        private static readonly Lazy<Global> instance = new Lazy<Global>(() => new Global());

        public static Global Instance
        {
            get { return instance.Value; }
        }

        private Setting _setting;
        private System _system;
        private Devices _devices;


        public Setting Settings { get => _setting; set => _setting = value; }
        public System System { get => _system; set => _system = value; }
        public Devices Devices { get => _devices; set => _devices = value; }


        private Global()
        {
            _setting = new Setting();
            _system = new System();
            _devices = new Devices();

        }


    }
}
