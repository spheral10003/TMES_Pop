using System;
using System.Windows.Forms;
using DevExpress.XtraEditors;
using SEOJIN_MEIS.Client.ApiClient;
using SEOJIN_MEIS.Client.Forms.Common;
using SEOJIN_MEIS.Client.Composition;
using SEOJIN_MEIS.Client.Localization;
using SEOJIN_MEIS.Client.Theme;

namespace SEOJIN_MEIS.Client.Forms.WorkIntegratedStatus
{
    /// <summary>
    /// MEIS > 작업통합 개요 > 작업통합 현황 조회. 부서/라인 단위 집계는 서버가 수행, 화면은 결과 표시 전용.
    /// 화면은 상단 카드 + 결과 그리드 카드로 구성되며, 색은 <see cref="AppTheme"/>가 담당한다(포인트 컬러: Violet).
    /// VS 디자이너 호환을 위해 매개변수 없는 생성자만 두고, 실제 의존성은 Initialize()로 주입한다.
    /// </summary>
    public partial class WorkIntegratedStatusScreen : XtraUserControl, IThemedScreen
    {
        private ClientContext _context;

        public WorkIntegratedStatusScreen()
        {
            InitializeComponent();
        }

        public void Initialize(ClientContext context)
        {
            _context = context;

            lblTitle.Text = Strings.WorkIntegratedStatus_Title;
            lblGridTitle.Text = Strings.WorkIntegratedStatus_GridTitle;
            btnRefresh.Text = Strings.Common_Refresh;

            ApplyTheme();

            Load += async (s, e) => await RefreshAsync();
        }

        /// <summary>현재 테마 색을 화면에 입힌다(테마 전환 시 MainForm이 다시 호출).</summary>
        public void ApplyTheme()
        {
            BackColor = AppTheme.Surface;
            spacer.BackColor = AppTheme.Surface;

            AppTheme.CardPanel(topCard);
            AppTheme.CardPanel(gridCard);
            AppTheme.SectionTitle(lblTitle, AppTheme.Violet);
            AppTheme.SectionTitle(lblGridTitle, AppTheme.Violet);
            AppTheme.AccentButton(btnRefresh, AppTheme.Violet, AppIcons.Refresh);
            AppTheme.Grid(grid, gridView, AppTheme.Violet);
        }

        private async void btnRefresh_Click(object sender, EventArgs e) => await RefreshAsync();

        private async System.Threading.Tasks.Task RefreshAsync()
        {
            try
            {
                var result = await _context.ApiClients.ProductionApiClient.GetWorkIntegratedStatusAsync();
                grid.DataSource = result;
            }
            catch (ApiException ex)
            {
                AppMessageBox.Warn(this, ex.Message, Strings.WorkIntegratedStatus_Title);
            }
        }
    }
}
