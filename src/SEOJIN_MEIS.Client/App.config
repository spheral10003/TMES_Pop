<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>

  <appSettings>
    <!--
      TODO: 실제 서버 주소로 교체.
      주의: 스킴(http/https)을 서버 실제 구성과 반드시 일치시킬 것.
      서버가 평문 HTTP인데 https://로 호출하면 "예기치 않은 패킷 형식으로 인해 핸드셰이크가 실패했습니다" 오류가 난다.
    -->
    <add key="ApiBaseUrl" value="http://localhost:8080/" />
    <add key="ApiTimeoutSeconds" value="30" />
    <add key="DefaultCulture" value="ko-KR" />

    <!--
      서버 API 대신 목업 데이터로 화면을 확인할지 여부.
      true면 POP 진입 화면의 [조회]가 서버를 호출하지 않고 화면 설계서 샘플 데이터를 그리드에 바인딩한다
      (샘플 데이터: SEOJIN_MEIS.Client/Mock/MockWorkOrderData.cs).
      서버 API가 붙으면 false로 되돌릴 것.
    -->
    <add key="UseMockData" value="true" />

    <!--
      안 읽은 알림 개수를 서버에 물어보는 주기(초). 상단 종 아이콘의 빨간 배지 숫자가 이 간격으로 갱신된다.
      0 이하로 두면 폴링을 하지 않는다(서버가 아직 없을 때 호출을 아예 막고 싶은 경우).
    -->
    <add key="NotificationPollingSeconds" value="60" />

    <!-- 자동 로그아웃까지의 세션 유지 시간(분). 메인 화면 우측 상단에 남은 시간이 카운트다운으로 표시된다(300분 = 05:00:00). -->
    <add key="SessionTimeoutMinutes" value="300" />

    <!--
      작업 표준/도면 PDF가 들어 있는 SMB 공유 폴더(JSON). POP 화면 좌측 도면 영역이 여기서 파일을 읽는다.
      표시할 파일 경로는 서버(진행 중 공정 정보 API)가 DrawingFilePath로 내려주며,
      상대 경로면 아래 RootPath와 합쳐 실제 UNC 경로가 된다.

        RootPath : 공유 폴더 루트. 예 "\\\\192.168.0.50\\drawings" (JSON이라 역슬래시를 두 번 쓴다)
                   비워 두면 도면 영역에 "공유 폴더 미설정" 안내만 나오고 파일 접근을 시도하지 않는다.
        UserName : 공유 접속 계정. **비우면 현재 로그인한 윈도우 계정으로 접근한다(권장)**.
                   값이 있으면 그 계정으로 공유에 연결한다(WNetAddConnection2).
        Password : UserName을 채운 경우에만 사용.
        Domain   : 도메인/컴퓨터 이름. UserName에 "DOMAIN\\user" 형태로 이미 넣었으면 비워 둔다.

      보안 주의: Password를 채우면 이 파일에 평문으로 남는다.
      가능하면 PC를 도메인에 넣고 UserName/Password를 비운 채 쓰거나, 배포 시 이 파일의 접근 권한을 제한할 것.
    -->
    <add key="DocumentShare" value="{&quot;RootPath&quot;:&quot;&quot;,&quot;UserName&quot;:&quot;&quot;,&quot;Password&quot;:&quot;&quot;,&quot;Domain&quot;:&quot;&quot;}" />

    <!--
      설비(Tool) Modbus-TCP 접속 목록(JSON 배열). 운영 환경에 맞춰 EquipmentId/Host/Port를 채운다. 예시 2대 구성.

      한 설비에 두 종류의 Connection이 열린다 (장비 통신 규격):
        - Standard   Modbus-TCP connection : Port        요청/응답 한 쌍. 실시간 이벤트 수신을 제외한 모든 Read/Write.
        - Customized Modbus-TCP connection : EventPort   Tool(Slave)→Controller(Master) 실시간 이벤트 전용. Read/Write 미지원.
                                                        0으로 두면 스펙 기본 규칙대로 Port+1을 사용한다.
      필드 설명:
        UseStandardConnection / UseEventConnection : 각 Connection 사용 여부 (한쪽만 쓰려면 false)
        UnitId            : MBAP Unit Identifier(Slave 주소)
        ResponseTimeoutMs : 표준 Connection에서 응답을 기다리는 시간(ms)
        EventAckMode      : 이벤트 수신 확인 처리 - "None"(응답 없음) 또는 "Echo"(받은 프레임 그대로 회신)
        RegisterMap       : 논리 명령(Start/Stop/Reset/상태조회) ↔ 실제 Modbus 주소 매핑
                            TODO: 장비 레지스터 맵 문서 확정 후 실제 주소/값으로 교체할 것 (현재 값은 임시)
      Port/EventPort는 원래 Advertise / Scan ack / Search ack 메시지에 실려 오는 값이며,
      자동 탐색을 붙이기 전까지는 여기에 직접 적어 사용한다.
    -->
    <add key="Equipments" value="[{&quot;EquipmentId&quot;:&quot;EQ-001&quot;,&quot;EquipmentName&quot;:&quot;1호기&quot;,&quot;Host&quot;:&quot;192.168.0.101&quot;,&quot;Port&quot;:502,&quot;EventPort&quot;:0,&quot;UseStandardConnection&quot;:true,&quot;UseEventConnection&quot;:true,&quot;UnitId&quot;:1,&quot;ResponseTimeoutMs&quot;:3000,&quot;AutoConnect&quot;:true,&quot;EventAckMode&quot;:&quot;None&quot;,&quot;RegisterMap&quot;:{&quot;ControlRegisterAddress&quot;:0,&quot;StartValue&quot;:1,&quot;StopValue&quot;:2,&quot;ResetValue&quot;:3,&quot;StatusRegisterAddress&quot;:0,&quot;StatusRegisterCount&quot;:8,&quot;StatusUsesInputRegisters&quot;:false}},{&quot;EquipmentId&quot;:&quot;EQ-002&quot;,&quot;EquipmentName&quot;:&quot;2호기&quot;,&quot;Host&quot;:&quot;192.168.0.102&quot;,&quot;Port&quot;:502,&quot;EventPort&quot;:0,&quot;UseStandardConnection&quot;:true,&quot;UseEventConnection&quot;:true,&quot;UnitId&quot;:1,&quot;ResponseTimeoutMs&quot;:3000,&quot;AutoConnect&quot;:true,&quot;EventAckMode&quot;:&quot;None&quot;,&quot;RegisterMap&quot;:{&quot;ControlRegisterAddress&quot;:0,&quot;StartValue&quot;:1,&quot;StopValue&quot;:2,&quot;ResetValue&quot;:3,&quot;StatusRegisterAddress&quot;:0,&quot;StatusRegisterCount&quot;:8,&quot;StatusUsesInputRegisters&quot;:false}}]" />
  </appSettings>

  <system.net>
    <settings>
      <httpWebRequest useUnsafeHeaderParsing="true" />
    </settings>
  </system.net>
</configuration>
