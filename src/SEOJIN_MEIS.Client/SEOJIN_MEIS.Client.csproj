<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>SEOJIN_MEIS.Client</RootNamespace>
    <AssemblyName>SEOJIN_MEIS.Client</AssemblyName>
    <ApplicationIcon></ApplicationIcon>
    <NeutralLanguage>ko-KR</NeutralLanguage>
  </PropertyGroup>

  <!--
    Debug 구성에서는 OutputType=Exe(콘솔 서브시스템)로 빌드해 WinForms 창과 함께 콘솔 창이 자동으로 뜨게 한다.
    AppLog.Step/Info/... 가 Console.WriteLine으로 출력하므로 디버그 실행 중 단계별 로그를 콘솔 창에서 그대로 볼 수 있다.
    Release(배포용 ClickOnce)에서는 콘솔 창이 뜨면 안 되므로 WinExe(GUI 서브시스템) 그대로 둔다.
  -->
  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'!='Debug'">
    <OutputType>WinExe</OutputType>
  </PropertyGroup>

  <!--
    ClickOnce 배포 설정 (기본 골격).
    PublishUrl/InstallUrl, 서명 인증서, 배포 서버 위치는 환경마다 다르므로
    Visual Studio의 [프로젝트 > 게시(Publish)] 마법사에서 최종 확정할 것.
    아래 값은 로컬 폴더 게시를 가정한 기본값이다.
  -->
  <PropertyGroup>
    <PublishUrl>bin\publish\</PublishUrl>
    <Install>true</Install>
    <InstallFrom>Disk</InstallFrom>
    <UpdateEnabled>true</UpdateEnabled>
    <UpdateMode>Foreground</UpdateMode>
    <UpdateInterval>7</UpdateInterval>
    <UpdateIntervalUnits>Days</UpdateIntervalUnits>
    <UpdatePeriodically>false</UpdatePeriodically>
    <UpdateRequired>false</UpdateRequired>
    <MapFileExtensions>true</MapFileExtensions>
    <ApplicationRevision>0</ApplicationRevision>
    <ApplicationVersion>1.0.0.%2a</ApplicationVersion>
    <UseApplicationTrust>false</UseApplicationTrust>
    <BootstrapperEnabled>true</BootstrapperEnabled>
    <SignManifests>false</SignManifests>
    <GenerateManifests>true</GenerateManifests>
    <TargetZone>LocalIntranet</TargetZone>
    <ProductName>MEIS POP</ProductName>
    <PublisherName>SEOJIN_MEIS</PublisherName>
    <SuiteName>MEIS</SuiteName>
  </PropertyGroup>

  <!--
    DevExpress 26.1 로컬 설치 참조 (C:\Program Files\DevExpress 26.1\...).
    다른 개발 PC에서는 실제 설치 경로/버전 번호(v26.1.x.x)가 다를 수 있으니 HintPath를 확인/보정할 것.
    (Visual Studio에서 DevExpress 항목을 추가하면 자동으로 경로가 보정되는 경우가 많음)
  -->
  <ItemGroup>
    <Reference Include="System.Configuration" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="DevExpress.Data.v26.1">
      <HintPath>C:\Program Files\DevExpress 26.1\Components\Bin\Framework\DevExpress.Data.v26.1.dll</HintPath>
    </Reference>
    <Reference Include="DevExpress.Data.Desktop.v26.1">
      <HintPath>C:\Program Files\DevExpress 26.1\Components\Bin\Framework\DevExpress.Data.Desktop.v26.1.dll</HintPath>
    </Reference>
    <Reference Include="DevExpress.Drawing.v26.1">
      <HintPath>C:\Program Files\DevExpress 26.1\Components\Bin\Framework\DevExpress.Drawing.v26.1.dll</HintPath>
    </Reference>
    <Reference Include="DevExpress.Utils.v26.1">
      <HintPath>C:\Program Files\DevExpress 26.1\Components\Bin\Framework\DevExpress.Utils.v26.1.dll</HintPath>
    </Reference>
    <Reference Include="DevExpress.Printing.v26.1.Core">
      <HintPath>C:\Program Files\DevExpress 26.1\Components\Bin\Framework\DevExpress.Printing.v26.1.Core.dll</HintPath>
    </Reference>
    <Reference Include="DevExpress.XtraEditors.v26.1">
      <HintPath>C:\Program Files\DevExpress 26.1\Components\Bin\Framework\DevExpress.XtraEditors.v26.1.dll</HintPath>
    </Reference>
    <Reference Include="DevExpress.XtraBars.v26.1">
      <HintPath>C:\Program Files\DevExpress 26.1\Components\Bin\Framework\DevExpress.XtraBars.v26.1.dll</HintPath>
    </Reference>
    <Reference Include="DevExpress.XtraLayout.v26.1">
      <HintPath>C:\Program Files\DevExpress 26.1\Components\Bin\Framework\DevExpress.XtraLayout.v26.1.dll</HintPath>
    </Reference>
    <Reference Include="DevExpress.XtraGrid.v26.1">
      <HintPath>C:\Program Files\DevExpress 26.1\Components\Bin\Framework\DevExpress.XtraGrid.v26.1.dll</HintPath>
    </Reference>
    <!-- 작업통합 현황 조회의 [작업 통합 개요] 계층 트리 + 엑셀 내보내기 -->
    <Reference Include="DevExpress.XtraTreeList.v26.1">
      <HintPath>C:\Program Files\DevExpress 26.1\Components\Bin\Framework\DevExpress.XtraTreeList.v26.1.dll</HintPath>
    </Reference>
    <Reference Include="DevExpress.XtraPrinting.v26.1">
      <HintPath>C:\Program Files\DevExpress 26.1\Components\Bin\Framework\DevExpress.XtraPrinting.v26.1.dll</HintPath>
    </Reference>
    <!-- POP 화면 좌측의 작업 표준/도면 PDF 뷰어 (SMB 공유 폴더에서 읽은 PDF를 스트림으로 표시) -->
    <Reference Include="DevExpress.XtraPdfViewer.v26.1">
      <HintPath>C:\Program Files\DevExpress 26.1\Components\Bin\Framework\DevExpress.XtraPdfViewer.v26.1.dll</HintPath>
    </Reference>
    <Reference Include="DevExpress.Pdf.v26.1.Core">
      <HintPath>C:\Program Files\DevExpress 26.1\Components\Bin\Framework\DevExpress.Pdf.v26.1.Core.dll</HintPath>
    </Reference>
    <Reference Include="DevExpress.Pdf.v26.1.Drawing">
      <HintPath>C:\Program Files\DevExpress 26.1\Components\Bin\Framework\DevExpress.Pdf.v26.1.Drawing.dll</HintPath>
    </Reference>
    <!-- Office 계열 등 추가 스킨(Program.cs에서 적용) -->
    <Reference Include="DevExpress.BonusSkins.v26.1">
      <HintPath>C:\Program Files\DevExpress 26.1\Components\Bin\Framework\DevExpress.BonusSkins.v26.1.dll</HintPath>
    </Reference>
    <!--
      DevExpress.XtraTab.v26.1 / DevExpress.XtraSplashScreen.v26.1은 이 개발 PC의 현재 DevExpress 설치본에
      포함되어 있지 않아(Tab & Navigation, Splash Screen 모듈 미설치) 참조에서 제외했다.
      DevExpress Installer에서 [Modify]로 해당 모듈을 추가 설치하면, MainForm.cs의 자체 탭 스트립을
      DevExpress.XtraTab.XtraTabControl로 교체해 더 완성도 높은 UI로 바꿀 수 있다.
    -->
  </ItemGroup>

  <!--
    브랜드 이미지(Images 폴더)는 어셈블리에 포함해서 배포한다 — exe만 복사해도 그림이 따라간다.
    코드(Theme/AppImages.cs)는 아래 LogicalName으로 찾으므로, 파일 이름을 바꿔도 LogicalName은 그대로 둘 것.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Images\login_icon.png">
      <LogicalName>SEOJIN_MEIS.Client.Images.login_icon.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Images\11_Texon_Logo_Signature.svg">
      <LogicalName>SEOJIN_MEIS.Client.Images.texon_logo.svg</LogicalName>
    </EmbeddedResource>

    <!-- 상단 바 아이콘 -->
    <EmbeddedResource Include="Images\bell-regular.png">
      <LogicalName>SEOJIN_MEIS.Client.Images.bell-regular.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Images\circle-user-regular.png">
      <LogicalName>SEOJIN_MEIS.Client.Images.circle-user-regular.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Images\power-off-solid.png">
      <LogicalName>SEOJIN_MEIS.Client.Images.power-off-solid.png</LogicalName>
    </EmbeddedResource>

    <!-- 언어 선택 국기. LogicalName의 flag_XX 는 AppImages.Flag(문화권 두 글자 코드)와 짝이다. -->
    <EmbeddedResource Include="Images\flag\ko.png">
      <LogicalName>SEOJIN_MEIS.Client.Images.flag_ko.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Images\flag\en.png">
      <LogicalName>SEOJIN_MEIS.Client.Images.flag_en.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Images\flag\vi.png">
      <LogicalName>SEOJIN_MEIS.Client.Images.flag_vi.png</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SEOJIN_MEIS.Client.Common\SEOJIN_MEIS.Client.Common.csproj" />
    <ProjectReference Include="..\SEOJIN_MEIS.Client.ApiClient\SEOJIN_MEIS.Client.ApiClient.csproj" />
    <ProjectReference Include="..\SEOJIN_MEIS.Client.Equipment\SEOJIN_MEIS.Client.Equipment.csproj" />
  </ItemGroup>

</Project>
