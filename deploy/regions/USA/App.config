<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>

  <!--
    ClickOnce 게시용 App.config — 지역: 미국 (USA).
    deploy/Publish-ClickOnce.ps1 -Region USA 로 게시하면 이 파일이 SEOJIN_TMES_POP.exe.config 로 들어간다.
    개발 PC에서 F5로 실행할 때는 src/SEOJIN_TMES.Client/App.config 가 쓰인다(이 파일은 게시 때만 쓰임).

    [입력 필요] 값이 비어 있는 ApiBaseUrl · ServerName 은 게시 스크립트가 물어보고 이 파일에 채워 넣는다
    (직접 편집해도 된다). 둘 중 하나라도 비어 있으면 게시하지 않는다.

    주의: 게시된 파일은 배포 웹 서버에서 누구나 내려받을 수 있다(.config.deploy).
    비밀번호 같은 값은 넣지 않는 것이 원칙 — 아래 DocumentShare 참고.
  -->
  <appSettings>
    <!--
      [입력 필요] 미국 API 서버 주소(끝에 / 포함). 예 "http://10.200.1.237:8080/"
      스킴(http/https)을 서버 실제 구성과 반드시 일치시킬 것.
      서버가 평문 HTTP인데 https://로 호출하면 "예기치 않은 패킷 형식으로 인해 핸드셰이크가 실패했습니다" 오류가 난다.
    -->
    <add key="ApiBaseUrl" value="" />
    <add key="ApiTimeoutSeconds" value="30" />

    <!--
      API 응답 본문을 로그에 남길지 여부 / 남길 최대 길이(자).
      현장 운영 배포에서는 업무 데이터가 로그에 그대로 남고 용량도 커지므로 false 로 둔다.
    -->
    <add key="LogApiResponseBody" value="false" />
    <add key="LogApiResponseBodyMaxLength" value="4000" />

    <!-- 처음 설치했을 때 로그인 화면의 언어. ko-KR / en-US / vi-VN -->
    <add key="DefaultCulture" value="en-US" />

    <!-- [입력 필요] 사업장 코드(corpCd). 로그인할 때 서버가 이 값으로 계정을 찾는다. 예 구미 = "GUM" -->
    <add key="ServerName" value="" />
    <add key="UploadMaxMegaBytes" value="1000" />

    <!-- 안 읽은 알림 개수 폴링 주기(초). 0 이하면 폴링하지 않는다. -->
    <add key="NotificationPollingSeconds" value="60" />

    <!-- 자동 로그아웃까지의 세션 유지 시간(분). -->
    <add key="SessionTimeoutMinutes" value="300" />
    <!--
      설비(Nutrunner) Modbus-TCP 연결 설정. Request · Event 두 채널 모두 적용된다.
        ModbusConnectTimeoutMs    : TCP 접속 제한 시간(ms). 기본 500. 0 이하면 OS 기본값(약 21초)까지 기다린다.
                                    망이 느려 "접속 시간 초과"가 잦으면 늘린다.
        ModbusKeepAliveTimeMs     : 무통신 후 첫 TCP KeepAlive 확인까지의 시간(ms). 기본 5000. 0 이하면 KeepAlive 끔.
        ModbusKeepAliveIntervalMs : KeepAlive 응답이 없을 때 재확인 간격(ms). 기본 5000.
      KeepAlive는 랜선 단선 · 장비 전원 차단처럼 신호 없이 끊긴 연결을 감지하려고 쓴다.
      Windows는 재확인을 10회 하므로 끊김 감지까지 약 TimeMs + 10 × IntervalMs(기본 약 55초)가 걸린다.
    -->
    <add key="ModbusConnectTimeoutMs" value="500" />
    <add key="ModbusKeepAliveTimeMs" value="5000" />
    <add key="ModbusKeepAliveIntervalMs" value="5000" />

    <!--
      작업 표준/도면 PDF가 들어 있는 SMB 공유 폴더(JSON) — 지역 공유 폴더가 정해지면 채운다.
        RootPath : 공유 폴더 루트. 예 "\\\\10.200.1.31\\sjapp\\attach\\" (JSON이라 역슬래시를 두 번 쓴다)
                   비워 두면 도면 영역에 "공유 폴더 미설정" 안내만 나오고 파일 접근을 시도하지 않는다.
        UserName : 공유 접속 계정. **비우면 현재 로그인한 윈도우 계정으로 접근한다(권장)**.
        Password : UserName을 채운 경우에만 사용. 배포 서버에서 평문으로 내려받을 수 있으니 되도록 비울 것.
        Domain   : 도메인/컴퓨터 이름.
    -->
    <add key="DocumentShare" value="{&quot;RootPath&quot;:&quot;&quot;,&quot;UserName&quot;:&quot;&quot;,&quot;Password&quot;:&quot;&quot;,&quot;Domain&quot;:&quot;&quot;}" />

    <!--
      설비(Tool) Modbus-TCP 접속 목록(JSON 배열). 설비 IP는 PC(라인)마다 다르므로 게시본은 빈 목록으로 둔다.
      형식은 src/SEOJIN_TMES.Client/App.config 의 Equipments 예시 참고.
    -->
    <add key="Equipments" value="[]" />
  </appSettings>

  <system.net>
    <settings>
      <httpWebRequest useUnsafeHeaderParsing="true" />
    </settings>
  </system.net>
</configuration>
