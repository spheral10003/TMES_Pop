<?xml version="1.0" encoding="utf-8"?>
<!--
  ClickOnce 게시 지역 설정 — 화성 운영 (HWASEONG_PROD).
  SEOJIN_TMES.Client.csproj 가 -p:Region=HWASEONG_PROD 로 빌드될 때만 이 파일을 불러온다.
-->
<Project>
  <PropertyGroup>
    <!--
      [입력 필요] 배포 서버 주소 — 현장 PC가 설치 · 업데이트 확인 때 접속하는 URL(끝에 / 필수).
      예 "https://tmes-gm-test.texon.co.kr/pop/"
      비어 있으면 게시 스크립트가 물어보고 여기에 채워 넣는다. -DeployBaseUrl 로 이번 게시에만 덮어쓸 수도 있다.
      주의: 이미 설치된 PC는 설치할 때의 주소로 업데이트를 확인한다. 주소를 바꾸면 기존 PC는
      옛 주소에도 새 버전을 한 번 게시하거나, PC에서 제거 후 새 주소로 재설치해야 한다.
    -->
    <DeployBaseUrl Condition="'$(DeployBaseUrl)'==''">https://tmes-hs.texon.co.kr/mes_client/</DeployBaseUrl>

    <!-- 시작 메뉴 · 바탕화면 바로가기 · 프로그램 추가/제거에 보이는 이름. -->
    <ProductName>TMES POP (화성)</ProductName>

    <!--
      ClickOnce 앱 ID(exe · .application 이름). 지역마다 달라야 한 PC에 여러 지역을 따로 설치할 수 있다 —
      같으면 ClickOnce가 같은 프로그램으로 보고 다른 지역 설치를 막거나 덮어쓴다.
      주의: 바꾸면 다른 프로그램이 되므로 이미 설치된 PC는 업데이트를 받지 못한다(제거 후 재설치).
    -->
    <AssemblyName>SEOJIN_TMES_POP_HS_PRD</AssemblyName>

    <!-- 게시본의 exe.config 로 들어갈 파일. 개발용 src/SEOJIN_TMES.Client/App.config 대신 쓰인다. -->
    <AppConfig>$(MSBuildThisFileDirectory)App.config</AppConfig>
  </PropertyGroup>
</Project>
