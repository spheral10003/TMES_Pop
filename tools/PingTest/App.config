<?xml version="1.0" encoding="utf-8"?>
<!--
  빌드하면 PingTest.exe.config 로 복사된다. 현장에서는 exe 옆의 PingTest.exe.config 를 메모장으로 고치면 된다.
  명령줄 인자를 주면 같은 항목은 인자가 우선한다.
-->
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
  <appSettings>
    <!-- Ping 대상. 여러 개는 쉼표(,)로 구분. 값이 있으면 exe 더블클릭 시 바로 시작한다. 비우면 실행 때 물어본다. (기본: 비어 있음) -->
    <add key="Hosts" value="" />
    <!-- 전송 간격(ms). (기본 1000) -->
    <add key="IntervalMs" value="1000" />
    <!-- 응답 대기 타임아웃(ms). (기본 1000) -->
    <add key="TimeoutMs" value="1000" />
    <!-- 데이터 크기(byte), 0~65500. (기본 32) -->
    <add key="BufferSize" value="32" />
    <!-- 대상별 전송 횟수. 0이면 Ctrl+C 까지 계속. (기본 0) -->
    <add key="Count" value="0" />
    <!-- 로그 폴더. 비우면 exe 폴더\logs. 상대 경로는 exe 폴더 기준. (기본: 비어 있음) -->
    <add key="LogDirectory" value="" />
  </appSettings>
</configuration>
